FROM postgres:15-alpine

# Install bash as the wrapper script depends on it
RUN apk add --no-cache bash

# Copy the "Always-Run" wrapper script
COPY init-db-wrapper.sh /usr/local/bin/init-db-wrapper.sh

# Ensure the script is executable
RUN chmod +x /usr/local/bin/init-db-wrapper.sh

# Set the wrapper as the entrypoint
ENTRYPOINT ["init-db-wrapper.sh"]